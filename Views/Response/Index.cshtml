<html>
<head>
    <title>DemoApp</title>
    <link rel="icon" href="https://www.f5.com/content/dam/f5/f5-logo.svg">
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>

    <div class="banner-container">
        <img src="https://www.f5.com/content/dam/f5/f5-logo.svg" class="img-logo">
        <img src="https://www.f5.com/content/dam/f5-com/global-assets/f5-logos/distributed-cloud-services.svg" class="img-logo-text">
    </div>

    <div class="menu-container">
        <ul class="menu">
            <li><a href="/home">Home</a></li>
            <li><a href="/response">Response</a></li>
            <li><a href="/attack">Attack</a></li>
            <li><a href="/login">Login</a></li>
            <!--<li><a href="/cat">API</a></li>-->
        </ul>
    </div>

    <div class="button-container">
        <button class="button" onclick="loadResponse('/Response/Forbidden')">403 Forbidden</button>
        <button class="button" onclick="loadResponse('/Response/NotFound')">404 NotFound</button>
        <button class="button" onclick="loadResponse('/Response/Unavailable')">503 Unavailable</button>
    </div>

    <div class="frame-container">
        <iframe class="frame" id="responseFrame" src="" frameborder="0"></iframe>
    </div>

    <div class="script-container">
    <script>
        function loadResponse(url) {
            document.getElementById('responseFrame').src = url;
        }
    </script>
    </div>

    <div class="disclaimer">
        Site is for demonstration only. Not an official F5 property.
    </div>

</body>
</html>