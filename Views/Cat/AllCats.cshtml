<html>
<head>
    <title>DemoApp</title>
    <link rel="icon" href="https://www.f5.com/content/dam/f5/f5-logo.svg">
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>

<div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Pet ID</th>
                    <th>Name</th>
                    <th>Breed</th>
                    <th>Age</th>
                    <th>Location</th>
                    <th>Phone Number</th>
                    <th>Email</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model)
                {
                    <tr>
                        <td>@cat.PetID</td>
                        <td>@cat.Name</td>
                        <td>@cat.Breed</td>
                        <td>@cat.Age</td>
                        <td>@cat.Location</td>
                        <td>@cat.PhoneNumber</td>
                        <td>@cat.Email</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</body>
</html>
