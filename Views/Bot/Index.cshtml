    <div class="button-container">
        <button class="button" id="postButtonDeclared">Declared Bot</button>
        <button class="button" id="postButtonMasked">Masked Bot</button>
    </div>

    <div class="request-info-container" id="requestInfoContainer"></div>

    <div class="frame-container">
        <iframe class="frame" id="resultFrame"></iframe>
    </div>

    <div class="info-button-container">
        <button id="infoButton" class="info-button">Info</button>
    </div>

    <div id="infoFrame" class="info-frame">
        <div class="info-content">
            <p>Click one of the "Bot" buttons to simulate an automated request. The request is a POST to the /login page. The client is an application server making a server-side request.</p>

            <div class="info-item">
                <div class="info-item-label">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
                    Declared Bot
                </div>
                <p>A request made by a client which declares it's a bot via the user-agent. Signature-based WAF policies will identify this client as a malicious bot.</p>
            </div>

            <div class="info-item">
                <div class="info-item-label">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    Masked Bot
                </div>
                <p>A request made by a client masquerading as a browser. Signal-based bot defense is required to detect and mitigate this type of automation.</p>
            </div>
        </div>
    </div>

    <div id="overlay" class="overlay"></div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('requestInfoContainer').textContent = '';
        });

        const handleButtonClick = async (buttonId, userAgent) => {
            const buttonName = document.getElementById(buttonId).textContent;
            document.getElementById('requestInfoContainer').textContent = buttonName;

            try {
                const response = await fetch('/Bot/PostToLogin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({
                        protocol: window.location.protocol.replace(':', ''),
                        domain: window.location.hostname,
                        port: window.location.port || (window.location.protocol === 'https:' ? '443' : '80'),
                        userAgent: userAgent,
                    }),
                });
                const text = await response.text();
                document.getElementById('resultFrame').srcdoc = text;
            } catch (error) {
                document.getElementById('resultFrame').srcdoc = `<p style="color:red;">Error: ${error.message}</p>`;
            }
        };

        document.getElementById('postButtonDeclared').addEventListener('click', () => {
            handleButtonClick('postButtonDeclared', 'Mozilla/5.0 (compatible; Ask Jeeves/Teoma;)');
        });

        document.getElementById('postButtonMasked').addEventListener('click', () => {
            handleButtonClick('postButtonMasked', navigator.userAgent);
        });

        document.getElementById('infoButton').addEventListener('click', () => {
            document.getElementById('infoFrame').style.display = 'block';
            document.getElementById('overlay').style.display = 'block';
        });

        const closeModal = () => {
            document.getElementById('infoFrame').style.display = 'none';
            document.getElementById('overlay').style.display = 'none';
        };

        document.getElementById('overlay').addEventListener('click', closeModal);
        document.getElementById('infoFrame').addEventListener('click', closeModal);
    </script>
}
