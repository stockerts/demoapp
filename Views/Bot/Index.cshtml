    <div class="button-container">
        <button class="button" id="postButtonDeclared">Declared Bot</button>
        <button class="button" id="postButtonMasked">Masked Bot</button>
    </div>

    <div class="request-info-container" id="requestInfoContainer"></div>

    <div class="frame-container">
        <iframe class="frame" id="resultFrame"></iframe>
    </div>

    <div class="info-button-container">
        <button id="infoButton" class="info-button">Info</button>
    </div>

    <div id="infoFrame" class="info-frame">
        <div class="info-content">
            <p>Click one of the "Bot" buttons to simulate an automated request. The request is a POST to the /login page. The client is a application server making a server-side request.</p>
            <p><strong>Declared Bot:</strong> A request made by a client which declares it's a bot via the user-agent.</p>
            <p>Signature-Based WAF polices will identify this client as a Malicious Bot.</p>
            <p><strong>Masked Bot:</strong> A request made by a client that is masquerading as a browser.</p>
            <p>Signal-Based Bot Defense is required to detect and mitigate this type of automation.</p>
        </div>
    </div>

    <div id="overlay" class="overlay"></div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('requestInfoContainer').textContent = '';
        });

        const handleButtonClick = async (buttonId, userAgent) => {
            const buttonName = document.getElementById(buttonId).textContent;
            document.getElementById('requestInfoContainer').textContent = buttonName;

            try {
                const response = await fetch('/Bot/PostToLogin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({
                        protocol: window.location.protocol.replace(':', ''),
                        domain: window.location.hostname,
                        port: window.location.port || (window.location.protocol === 'https:' ? '443' : '80'),
                        userAgent: userAgent,
                    }),
                });
                const text = await response.text();
                document.getElementById('resultFrame').srcdoc = text;
            } catch (error) {
                document.getElementById('resultFrame').srcdoc = `<p style="color:red;">Error: ${error.message}</p>`;
            }
        };

        document.getElementById('postButtonDeclared').addEventListener('click', () => {
            handleButtonClick('postButtonDeclared', 'Mozilla/5.0 (compatible; Ask Jeeves/Teoma;)');
        });

        document.getElementById('postButtonMasked').addEventListener('click', () => {
            handleButtonClick('postButtonMasked', navigator.userAgent);
        });

        document.getElementById('infoButton').addEventListener('click', () => {
            document.getElementById('infoFrame').style.display = 'block';
            document.getElementById('overlay').style.display = 'block';
        });

        const closeModal = () => {
            document.getElementById('infoFrame').style.display = 'none';
            document.getElementById('overlay').style.display = 'none';
        };

        document.getElementById('overlay').addEventListener('click', closeModal);
        document.getElementById('infoFrame').addEventListener('click', closeModal);
    </script>
}
