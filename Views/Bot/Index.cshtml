<html>
<head>
    <title>DemoApp</title>
    <link rel="icon" href="/images/f5-logo.svg">
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>

    <div class="banner-container">
        <img src="/images/f5-logo.svg" class="img-logo">
        <img src="/images/demo-app-title.png" class="img-logo-text">
    </div>

    <div class="menu-container">
        <ul class="menu">
            <li><a href="/home">Home</a></li>
            <li><a href="/client">Client</a></li>
            <li><a href="/response">Response</a></li>
            <li><a href="/attack">Attack</a></li>
            <li><a href="/bot">Bot</a></li>
            <li><a href="/login">Login</a></li>
        </ul>
    </div>
    <div class="button-container">
        <button class="button" id="postButtonDeclared">Declared Bot</button>
        <button class="button" id="postButtonObscured">Obscured Bot</button>
    </div>
    <div class="request-info-container" id="requestInfoContainer" style="margin-bottom: 10px;"></div>


    <div class="frame-container">
        <iframe class="frame" id="resultFrame"></iframe>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Clear the request info container when the page initially loads
            const requestInfoContainer = document.getElementById('requestInfoContainer');
            requestInfoContainer.textContent = ''; // Clear any existing content
        });

        const handleButtonClick = async (buttonId, userAgent) => {
            const buttonName = document.getElementById(buttonId).textContent;

            // Update the request info container with only the button name
            const requestInfoContainer = document.getElementById('requestInfoContainer');
            requestInfoContainer.textContent = `${buttonName}`;

            try {
                const response = await fetch('/Bot/PostToLogin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({
                        protocol: window.location.protocol.replace(':', ''),
                        domain: window.location.hostname,
                        port: window.location.port || (window.location.protocol === 'https:' ? '443' : '80'),
                        userAgent: userAgent,
                    }),
                });

                const text = await response.text();
                document.getElementById('resultFrame').srcdoc = text;
            } catch (error) {
                document.getElementById('resultFrame').srcdoc = `<p style="color: red;">Error: ${error.message}</p>`;
            }
        };

        document.getElementById('postButtonDeclared').addEventListener('click', () => {
            handleButtonClick('postButtonDeclared', 'Mozilla/5.0 (compatible; Ask Jeeves/Teoma;)');
        });

        document.getElementById('postButtonObscured').addEventListener('click', () => {
            handleButtonClick('postButtonObscured', navigator.userAgent);
        });


    </script>

    <div class="disclaimer">
        Site is for demonstration only. Not an official F5 property.
    </div>
</body>
</html>
