<html>
<head>
    <title>DemoApp</title>
    <link rel="icon" href="/images/f5-logo.svg">
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>

    <div class="banner-container">
        <img src="/images/f5-logo.svg" class="img-logo">
        <img src="/images/demo-app-title.png" class="img-logo-text">
    </div>

    <div class="menu-container">
        <ul class="menu">
            <li><a href="/home">Home</a></li>
            <li><a href="/client">Client</a></li>
            <li><a href="/response">Response</a></li>
            <li><a href="/attack">Attack</a></li>
            <li><a href="/bot">Bot</a></li>
            <li><a href="/login">Login</a></li>
        </ul>
    </div>
    <div class="button-container">
        <button class="button" id="postButtonDeclared">Declared Bot</button>
        <button class="button" id="postButtonObscured">Obscured Bot</button>
    </div>
    <div class="request-info-container" id="urlDisplay" style="margin-bottom: 10px;"></div>

    <div class="frame-container">
        <iframe class="frame" id="resultFrame"></iframe>
    </div>

    <script>
        // Clear the URL display when the page initially loads
        document.addEventListener('DOMContentLoaded', () => {
            const urlDisplay = document.getElementById('urlDisplay');
            urlDisplay.textContent = ''; // Clear any existing content

            // Construct and display the URL when a button is pressed
            const protocol = window.location.protocol.replace(':', ''); // Remove the trailing colon
            const domain = window.location.hostname;
            const port = window.location.port || (protocol === 'https' ? '443' : '80'); // Default ports

            // Store for use in the POST request
            urlDisplay.dataset.protocol = protocol;
            urlDisplay.dataset.domain = domain;
            urlDisplay.dataset.port = port;
        });

        document.getElementById('postButtonDeclared').addEventListener('click', async () => {
            const protocol = document.getElementById('urlDisplay').dataset.protocol;
            const domain = document.getElementById('urlDisplay').dataset.domain;
            const port = document.getElementById('urlDisplay').dataset.port;

            // Get the name of the button clicked
            const buttonName = document.getElementById('postButtonDeclared').textContent;

            // Update the URL display to include the button name
            const urlDisplay = document.getElementById('urlDisplay');
            urlDisplay.textContent = `${buttonName} : ${protocol}://${domain}/login`;

            try {
                const response = await fetch('/Bot/PostToLogin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({
                        protocol,
                        domain,
                        port,
                        userAgent: 'Mozilla/5.0 (compatible; Ask Jeeves/Teoma;)'  // User-Agent
                    }),
                });

                const text = await response.text();
                document.getElementById('resultFrame').srcdoc = text;
            } catch (error) {
                document.getElementById('resultFrame').srcdoc = `<p style="color: red;">Error: ${error.message}</p>`;
            }
        });

        document.getElementById('postButtonObscured').addEventListener('click', async () => {
            const protocol = document.getElementById('urlDisplay').dataset.protocol;
            const domain = document.getElementById('urlDisplay').dataset.domain;
            const port = document.getElementById('urlDisplay').dataset.port;

            // Get the user agent of the client's browser
            const browserUserAgent = navigator.userAgent;

            // Get the name of the button clicked
            const buttonName = document.getElementById('postButtonObscured').textContent;

            // Update the URL display to include the button name
            const urlDisplay = document.getElementById('urlDisplay');
            urlDisplay.textContent = `${buttonName} : ${protocol}://${domain}/login`;

            try {
                const response = await fetch('/Bot/PostToLogin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({
                        protocol,
                        domain,
                        port,
                        userAgent: browserUserAgent  // User-Agent set to client's browser User-Agent
                    }),
                });

                const text = await response.text();
                document.getElementById('resultFrame').srcdoc = text;
            } catch (error) {
                document.getElementById('resultFrame').srcdoc = `<p style="color: red;">Error: ${error.message}</p>`;
            }
        });
    </script>

    <div class="disclaimer">
        Site is for demonstration only. Not an official F5 property.
    </div>
</body>
</html>
