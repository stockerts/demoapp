@{
    ViewData["Title"] = "Bot Page";
}

<h2>Bot Page</h2>

<div>
    <label for="protocol">Protocol:</label>
    <input type="text" id="protocol" readonly />
</div>
<div>
    <label for="domain">Domain:</label>
    <input type="text" id="domain" readonly />
</div>
<div>
    <label for="port">Port:</label>
    <input type="text" id="port" readonly />
</div>

<button id="postButton">Send Request</button>
<iframe id="resultFrame" style="width: 100%; height: 300px; border: 1px solid black;"></iframe>

<script>
    // Populate protocol, domain, and port based on the current URL
    document.addEventListener('DOMContentLoaded', () => {
        const protocol = window.location.protocol.replace(':', ''); // Remove the trailing colon
        const domain = window.location.hostname;
        const port = window.location.port || (protocol === 'https' ? '443' : '80'); // Default ports

        document.getElementById('protocol').value = protocol;
        document.getElementById('domain').value = domain;
        document.getElementById('port').value = port;
    });

    document.getElementById('postButton').addEventListener('click', async () => {
        const protocol = document.getElementById('protocol').value;
        const domain = document.getElementById('domain').value;
        const port = document.getElementById('port').value;

        try {
            const response = await fetch('/Bot/PostToLogin', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ protocol, domain, port }), // Pass form data
            });

            const text = await response.text();
            document.getElementById('resultFrame').srcdoc = text;
        } catch (error) {
            document.getElementById('resultFrame').srcdoc = `<p style="color: red;">Error: ${error.message}</p>`;
        }
    });
</script>

