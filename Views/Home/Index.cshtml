<!DOCTYPE html>
<html>
<head>
    <title>DemoApp</title>
    <link rel="icon" href="/images/f5-logo.svg">
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>

    <div class="banner-container">
        <img src="/images/f5-logo.svg" class="img-logo">
        <img src="/images/demo-app-title.png" class="img-logo-text">
    </div>

    <div class="button-home-grid">
        <button class="button-home" onclick="window.location.href='/response'">
            <span>Response</span>
            <img src="/images/response.png" alt="Response">
        </button>
        <button class="button-home" onclick="window.location.href='/waf'">
            <span>WAF</span>
            <img src="/images/waf.png" alt="WAF">
        </button>
        <button class="button-home" onclick="window.location.href='/bot'">
            <span>Bot</span>
            <img src="/images/robot.png" alt="Bot">
        </button>
        <button class="button-home" onclick="window.location.href='/rate'">
            <span>Rate</span>
            <img src="/images/rate.png" alt="Info">
        </button>
        <button class="button-home" onclick="window.location.href='/client'">
            <span>Client</span>
            <img src="/images/client.png" alt="Home">
        </button>
        <button class="button-home" onclick="window.location.href='/login'">
            <span>Login</span>
            <img src="/images/login.png" alt="Login">
        </button>
    </div>
    <div class="info-button-container">
        <button id="infoButton" class="info-button" onclick="window.location.href='/home/info'">Info</button>
    </div>

    <div class="disclaimer">
        Site is for demonstration only. Not an official F5 property.
    </div>

</body>
</html>