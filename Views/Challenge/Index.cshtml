    <div class="challenge-page">

        <div class="challenge-run-all-container">
            <button class="button" id="runAllButton">Run All</button>
        </div>

        <div class="challenge-grid">

            <!-- 1. Header -->
            <div class="challenge-card" id="card-header">
                <div class="challenge-card-header">
                    <div class="challenge-title">
                        <span class="challenge-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg>
                        </span>
                        Header
                    </div>
                    <span class="challenge-status" id="status-header" data-state="idle">—</span>
                </div>
                <div class="challenge-section-label">Scenario</div>
                <p class="challenge-scenario">A new proxy is in place, but the backend can't tell which requests have passed through it.</p>
                <div class="challenge-section-label">Expected</div>
                <p class="challenge-desc">All requests include the <code>f5-proxy: challenge</code> header.</p>
                <div class="challenge-section-label">Result</div>
                <div class="challenge-card-footer">
                    <span class="challenge-detail" id="detail-header"></span>
                    <button class="challenge-run-btn" data-challenge="header">Run</button>
                </div>
            </div>

            <!-- 2. Redirect -->
            <div class="challenge-card locked" id="card-redirect">
                <div class="challenge-card-header">
                    <div class="challenge-title">
                        <span class="challenge-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                        </span>
                        Redirect
                    </div>
                    <span class="challenge-status" id="status-redirect" data-state="locked"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                </div>
                <div class="challenge-section-label">Scenario</div>
                <p class="challenge-scenario">After a login page migration, old bookmarks and cached links still point to the old login path, returning 404s.</p>
                <div class="challenge-section-label">Expected</div>
                <p class="challenge-desc">Requests to <code>/old/login</code> are redirected to <code>/login</code>.</p>
                <div class="challenge-section-label">Result</div>
                <div class="challenge-card-footer">
                    <span class="challenge-detail" id="detail-redirect"></span>
                    <button class="challenge-run-btn" data-challenge="redirect" disabled>Run</button>
                </div>
            </div>

            <!-- 3. User-Agent -->
            <div class="challenge-card locked" id="card-useragent">
                <div class="challenge-card-header">
                    <div class="challenge-title">
                        <span class="challenge-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </span>
                        User-Agent
                    </div>
                    <span class="challenge-status" id="status-useragent" data-state="locked"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                </div>
                <div class="challenge-section-label">Scenario</div>
                <p class="challenge-scenario">A known bad actor has been hammering the app using a recognizable client signature.</p>
                <div class="challenge-section-label">Expected</div>
                <p class="challenge-desc">Requests with the user-agent <code>badactor</code> are blocked.</p>
                <div class="challenge-section-label">Result</div>
                <div class="challenge-card-footer">
                    <span class="challenge-detail" id="detail-useragent"></span>
                    <button class="challenge-run-btn" data-challenge="useragent" disabled>Run</button>
                </div>
            </div>

            <!-- 4. Rate Limit -->
            <div class="challenge-card locked" id="card-ratelimit">
                <div class="challenge-card-header">
                    <div class="challenge-title">
                        <span class="challenge-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="4"/><line x1="12" y1="20" x2="12" y2="10"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
                        </span>
                        Rate Limit
                    </div>
                    <span class="challenge-status" id="status-ratelimit" data-state="locked"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                </div>
                <div class="challenge-section-label">Scenario</div>
                <p class="challenge-scenario">Every few minutes, the app gets flooded with a sudden wave of requests that the backend can't keep up with.</p>
                <div class="challenge-section-label">Expected</div>
                <p class="challenge-desc">Requests are limited to less than 10 per second.</p>
                <div class="challenge-section-label">Result</div>
                <div class="challenge-card-footer">
                    <span class="challenge-detail" id="detail-ratelimit"></span>
                    <button class="challenge-run-btn" data-challenge="ratelimit" disabled>Run</button>
                </div>
            </div>

            <!-- 5. WAF -->
            <div class="challenge-card locked" id="card-waf">
                <div class="challenge-card-header">
                    <div class="challenge-title">
                        <span class="challenge-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </span>
                        WAF
                    </div>
                    <span class="challenge-status" id="status-waf" data-state="locked"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                </div>
                <div class="challenge-section-label">Scenario</div>
                <p class="challenge-scenario">Someone is probing the application with crafted inputs designed to manipulate the database.</p>
                <div class="challenge-section-label">Expected</div>
                <p class="challenge-desc">Malicious requests are blocked.</p>
                <div class="challenge-section-label">Result</div>
                <div class="challenge-card-footer">
                    <span class="challenge-detail" id="detail-waf"></span>
                    <button class="challenge-run-btn" data-challenge="waf" disabled>Run</button>
                </div>
            </div>

            <!-- 6. Bot -->
            <div class="challenge-card locked" id="card-botmasked">
                <div class="challenge-card-header">
                    <div class="challenge-title">
                        <span class="challenge-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
                        </span>
                        Bot
                    </div>
                    <span class="challenge-status" id="status-botmasked" data-state="locked"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                </div>
                <div class="challenge-section-label">Scenario</div>
                <p class="challenge-scenario">A bot targeting the login page is mimicking a real browser using a correct user-agent and normal-looking headers.</p>
                <div class="challenge-section-label">Expected</div>
                <p class="challenge-desc">Sophisticated bots are blocked from making POST requests to <code>/login</code>.</p>
                <div class="challenge-section-label">Result</div>
                <div class="challenge-card-footer">
                    <span class="challenge-detail" id="detail-botmasked"></span>
                    <button class="challenge-run-btn" data-challenge="botmasked" disabled>Run</button>
                </div>
            </div>

        </div>
    </div>

@section Scripts {
    <script>
        const challenges = ['header', 'redirect', 'useragent', 'ratelimit', 'waf', 'botmasked'];

        const actionMap = {
            header:    '/Challenge/RunHeader',
            redirect:  '/Challenge/RunRedirect',
            useragent: '/Challenge/RunUserAgent',
            ratelimit: '/Challenge/RunRateLimit',
            waf:       '/Challenge/RunWAF',
            botmasked: '/Challenge/RunBotMasked',
        };

        const lockIcon = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>';

        function setStatus(name, state) {
            const el = document.getElementById('status-' + name);
            el.setAttribute('data-state', state);
            if (state === 'idle')    { el.textContent = '—'; }
            if (state === 'locked')  { el.innerHTML = lockIcon; }
            if (state === 'running') { el.innerHTML = '<span class="challenge-spinner"></span>'; }
            if (state === 'pass')    { el.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'; }
            if (state === 'fail')    { el.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'; }
        }

        function setDetail(name, text) {
            document.getElementById('detail-' + name).textContent = text;
        }

        function unlock(name) {
            const card = document.getElementById('card-' + name);
            const btn = card.querySelector('.challenge-run-btn');
            card.classList.remove('locked');
            btn.disabled = false;
            if (document.getElementById('status-' + name).dataset.state === 'locked') {
                setStatus(name, 'idle');
            }
        }

        function unlockNext(name) {
            const idx = challenges.indexOf(name);
            if (idx >= 0 && idx < challenges.length - 1) {
                unlock(challenges[idx + 1]);
            }
        }

        async function runChallenge(name) {
            setStatus(name, 'running');
            setDetail(name, '');

            const params = {
                protocol: window.location.protocol.replace(':', ''),
                domain:   window.location.hostname,
                port:     window.location.port || (window.location.protocol === 'https:' ? '443' : '80'),
            };
            if (name === 'botmasked') params.userAgent = navigator.userAgent;
            const body = new URLSearchParams(params);

            try {
                const res = await fetch(actionMap[name], {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body,
                });
                const data = await res.json();
                setStatus(name, data.pass ? 'pass' : 'fail');
                setDetail(name, data.detail || '');
                if (data.pass) {
                    unlockNext(name);
                    setTimeout(() => {
                        document.getElementById('card-' + name).classList.add('passed');
                    }, 800);
                }
                return data.pass;
            } catch (err) {
                setStatus(name, 'fail');
                setDetail(name, err.message);
                return false;
            }
        }

        document.querySelectorAll('.challenge-run-btn').forEach(btn => {
            btn.addEventListener('click', () => runChallenge(btn.dataset.challenge));
        });


        document.getElementById('runAllButton').addEventListener('click', async () => {
            for (let i = 0; i < challenges.length; i++) {
                unlock(challenges[i]);
                const passed = await runChallenge(challenges[i]);
                if (!passed) break;
                if (i < challenges.length - 1) {
                    const delay = challenges[i] === 'ratelimit' ? 2000 : 1000;
                    await new Promise(resolve => setTimeout(resolve, delay));
                }
            }
        });
    </script>
}
