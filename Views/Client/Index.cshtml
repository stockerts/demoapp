@model Client.Controllers.ClientInfoViewModel
<html>
<head>
    <title>DemoApp</title>
    <link rel="icon" href="https://www.f5.com/content/dam/f5/f5-logo.svg">
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>

    <div class="banner-container">
        <img src="/images/f5-logo.svg" class="img-logo">
        <img src="/images/distributed-cloud-services.svg" class="img-logo-text">
    </div>

    <div class="menu-container">
        <ul class="menu">
            <li><a href="/home">Home</a></li>
            <li><a href="/client">Client</a></li>
            <li><a href="/response">Response</a></li>
            <li><a href="/attack">Attack</a></li>
            <li><a href="/login">Login</a></li>
            <!--<li><a href="/cat">API</a></li>-->
        </ul>
    </div>

    <div class="clientinfo-container">
        <h1>Client Information</h1>
        <p><strong>IP Address:</strong> @Model.IpAddress</p>
        <p><strong>X-Forwarded-For:</strong> @Model.XForwardedFor</p>
        <p><strong>Host:</strong> @Model.Host</p>
        <p><strong>User-Agent:</strong> @Model.UserAgent</p>
        <p><strong>Server:</strong> @Model.Server</p>
    </div>

    <div class="disclaimer">
        Site is for demonstration only. Not an official F5 property.
    </div>

</body>
</html>
