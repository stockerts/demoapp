@model Client.Controllers.ClientInfoViewModel
<html>
<head>
    <title>DemoApp</title>
    <link rel="icon" href="https://www.f5.com/content/dam/f5/f5-logo.svg">
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>

    <div class="banner-container">
        <img src="/images/f5-logo.svg" class="img-logo">
        <img src="/images/distributed-cloud-services.svg" class="img-logo-text">
    </div>

    <div class="menu-container">
        <ul class="menu">
            <li><a href="/home">Home</a></li>
            <li><a href="/client">Client</a></li>
            <li><a href="/response">Response</a></li>
            <li><a href="/attack">Attack</a></li>
            <li><a href="/login">Login</a></li>
        </ul>
    </div>

    <div class="clientinfo-container">
        <h1>Client Information</h1>
        <table class="clientinfo-table">
            <tr>
                <th>IP Address:</th>
                <td>@Model.IpAddress</td>
            </tr>
            <tr>
                <th>X-Forwarded-For:</th>
                <td>@Model.XForwardedFor</td>
            </tr>
            <tr>
                <th>Host:</th>
                <td>@Model.Host</td>
            </tr>
            <tr>
                <th>User-Agent:</th>
                <td>@Model.UserAgent</td>
            </tr>
            <tr>
                <th>Content-Security-Policy:</th>
                <td>@Model.CSP</td>
            </tr>
            <tr>
                <th>Server:</th>
                <td>@Model.Server</td>
            </tr>
            <tr>
                <th>XC-Custom:</th>
                <td>@Model.XCCustom</td>
            </tr>
        </table>
    </div>

    <div class="disclaimer">
        Site is for demonstration only. Not an official F5 property.
    </div>

</body>
</html>
