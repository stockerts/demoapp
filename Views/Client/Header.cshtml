@model Client.Controllers.HeaderInfoViewModel
<!DOCTYPE html>
<html>
<head>
    <title>DemoApp</title>
    <link rel="icon" href="/images/f5-logo.svg">
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>

    <div class="banner-container">
        <img src="/images/f5-logo.svg" class="img-logo">
        <img src="/images/demo-app-title.png" class="img-logo-text">
    </div>

    <div class="menu-container">
        <ul class="menu">
            <li><a href="/home">Home</a></li>
            <li><a href="/response">Response</a></li>
            <li><a href="/waf">WAF</a></li>
            <li><a href="/bot">Bot</a></li>
            <li><a href="/rate">Rate</a></li>
            <li><a href="/client">Client</a></li>
            <li><a href="/login">Login</a></li>
        </ul>
    </div>

    <div class="clientheader-container">
        <h1>Header Information</h1>
        <table class="clientheader-table">
                @foreach (var header in Model.Headers)
                {
                    <tr>
                        <th>@header.Key</th>
                        <td>@header.Value</td>
                    </tr>
                }
        </table>
    </div>

    <div class="disclaimer">
        Site is for demonstration only. Not an official F5 property.
    </div>

</body>
</html>
