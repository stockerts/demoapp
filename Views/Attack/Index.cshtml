<html>
<head>
    <title>DemoApp</title>
    <link rel="icon" href="/images/f5-logo.svg">
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>

    <div class="banner-container">
        <img src="/images/f5-logo.svg" class="img-logo">
        <img src="/images/demo-app-title.png" class="img-logo-text">
    </div>

    <div class="menu-container">
        <ul class="menu">
            <li><a href="/home">Home</a></li>
            <li><a href="/client">Client</a></li>
            <li><a href="/response">Response</a></li>
            <li><a href="/attack">Attack</a></li>
            <li><a href="/login">Login</a></li>
        </ul>
    </div>

    <div class="button-container">
        <button class="button" onclick="loadPage('/Attack/SQL?age=5%27%20OR%20%271%27=%271')">SQL</button>
        <button class="button" onclick="loadPage('/Attack/DIR?file=../../hidden_agenda.txt')">DIR</button>
        <button class="button" onclick="loadPage('/Attack/XSS?update=%3Cscript%3Ealert%28%27XSS%27%29%3B%3C%2Fscript%3E')">XSS</button>
        <button class="button" onclick="loginPost()">Bot</button>
    </div>

    <div class="request-info-container"></div>

    <div class="frame-container">
        <iframe class="frame" id="pageFrame"></iframe>
    </div>

    <div class="script-container">
        <script>
            function loadPage(url) {
                // Set the src attribute of the iframe
                document.getElementById('pageFrame').src = url;

                // Get the container element
                var requestContainer = document.querySelector('.request-info-container');

                // Clear any existing content in the container
                if (url === '/attack/bot') {
                    // If the page is /attack/bot, clear the request-info-container
                    var requestContainer = document.querySelector('.request-info-container');
                    requestContainer.innerHTML = "Request Info: direct login POST with credentials";
                } else {
                    // Otherwise, display the request URI
                    var decodedUrl = decodeURIComponent(url);
                    requestContainer.innerHTML = '';
                    var requestText = document.createTextNode("Request URI: " + decodedUrl);
                    requestContainer.appendChild(requestText);
                }
            }

            function loginPost() {
                var xhr = new XMLHttpRequest();
                var url = '/login/index';
                xhr.open('POST', url, true);
                xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
                
                // Update the request-info-container for login action
                var requestContainer = document.querySelector('.request-info-container');
                requestContainer.innerHTML = "Request Info: direct login POST with credentials";

                // The POST body content
                var body = 'username=admin&password=admin';
                
                xhr.onreadystatechange = function () {
                    if (xhr.readyState === 4) {
                        // When the request is completed
                        var responseContainer = document.getElementById('responseContainer'); // Get response container
                        if (xhr.status === 200 && xhr.responseText.includes("Login") && xhr.responseText.includes("Successful")) {
                            // Redirect to /attack/bot upon successful login
                            document.getElementById('pageFrame').src = '/attack/bot';
                        } else {
                            // Display the response in the response-container
                            document.getElementById('pageFrame').src = 'response'; 
                        }
                    }
                };
                
                // Send the POST request
                xhr.send(body);
            }
        </script>
    </div>

    <div class="disclaimer">
        Site is for demonstration only. Not an official F5 property.
    </div>

</body>
</html>
