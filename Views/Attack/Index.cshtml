<html>
<head>
    <title>DemoApp</title>
    <link rel="icon" href="https://www.f5.com/content/dam/f5/f5-logo.svg">
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>

    <div class="banner-container">
        <img src="https://www.f5.com/content/dam/f5/f5-logo.svg" class="img-logo">
        <img src="https://www.f5.com/content/dam/f5-com/global-assets/f5-logos/distributed-cloud-services.svg" class="img-logo-text">
    </div>

    <div class="menu-container">
        <ul class="menu">
            <li><a href="/home">Home</a></li>
            <li><a href="/response">Response</a></li>
            <li><a href="/attack">Attack</a></li>
            <li><a href="/login">Login</a></li>
            <!--<li><a href="/cat">API</a></li>-->
        </ul>
    </div>

    <div class="button-container">
        <button class="button" onclick="loadPage('/Attack/SQL?age=5%27%20OR%20%271%27=%271')">SQL</button>
        <button class="button" onclick="loadPage('/Attack/DIR?file=../../hidden_agenda.txt')">DIR</button>
        <button class="button" onclick="loadPage('/Attack/XSS?update=%3Cscript%3Ealert%28%27XSS%27%29%3B%3C%2Fscript%3E')">XSS</button>
        <button class="button" onclick="postCredentials()">Login</button>
    </div>

    <div class="request-info-container">
    </div>

    <div class="frame-container">
        <iframe class="frame" id="pageFrame">
        </iframe>
    </div>

    <div class="script-container">
        <script>
            function loadPage(url) {
                // Set the src attribute of the iframe
                document.getElementById('pageFrame').src = url;

                // Decode the URL to remove encoding
                var decodedUrl = decodeURIComponent(url)

                // Get the container element
                var requestContainer = document.querySelector('.request-info-container');

                // Clear any existing content in the container
                requestContainer.innerHTML = '';

                // Create a text node containing the request information
                var requestText = document.createTextNode("Request URI: " + decodedUrl); // You can add more details if needed

                // Append the text node to the container
                requestContainer.appendChild(requestText);
            }
            function postCredentials() {
                // Clear request-info-container
                var requestContainer = document.querySelector('.request-info-container');
                requestContainer.innerHTML = '';

                const url = '/login'; // Replace with your actual endpoint
                const username = 'admin';
                const password = 'admin';

                const formData = new FormData();
                formData.append('username', username);
                formData.append('password', password);

                fetch(url, {
                    method: 'POST',
                    body: formData
                })
                    .then(response => {
                        if (response.status === 200 || response.status === 302) {
                            // If status is 200 or 302, load the BOT page within the iframe
                            document.getElementById('pageFrame').src = '/Attack/Bot_Pass';
                        } else if (!response.ok) {
                            document.getElementById('pageFrame').src = '/Attack/Bot_Fail';
                        }
                    })
                    .catch(error => {
                        // Handle error
                        console.error('There was a problem with the fetch operation:', error);
                    });
            }
        </script>

    </div>

    <div class="disclaimer">
        Site is for demonstration only. Not an official F5 property.
    </div>

</body>
</html>
